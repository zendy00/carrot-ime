<?xml version="1.0" encoding="utf-8"?>
<!--
  self-contained 단일 exe 배포 프로파일 (Ticket 07).
  사용: dotnet publish src/CarrotIME/CarrotIME.csproj -p:PublishProfile=win-x64
  결과: bin/publish/CarrotIME.exe 하나. .NET 런타임 미설치 PC에서도 실행.
  트리밍은 하지 않음 — WinForms/UIA 반사 코드가 깨질 수 있어 안전 우선.
  NativeAOT는 WinForms 미지원이라 사용하지 않음(ADR-0002).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- R2R 이미지는 1.5~2배 커서, 압축 단일파일(어셈블리를 통째로 RAM에 해제)에선
         메모리 점유를 그만큼 키운다. 부팅당 1회 실행이라 JIT 시작 비용을 감수하고 끔. -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishDir>bin\publish\</PublishDir>
    <!-- 배포본에는 exe 하나만 남도록 디버그 심볼(.pdb) 생성 안 함 -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- 참조 프로젝트(Core)의 .pdb/.xml도 출력에 복사하지 않음 -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
</Project>
